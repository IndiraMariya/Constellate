{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Constellate",
  "version": "1.0.0",
  "identifier": "com.indira.constellate",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Constellate",
        "width": 600,
        "height": 720,
        "minWidth": 420,
        "minHeight": 520,
        "resizable": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
